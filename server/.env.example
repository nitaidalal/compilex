NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/runbox
CLIENT_ORIGIN=http://localhost:5173

# Sandbox limits (per run, compile + execution)
SANDBOX_MEMORY_MB=256
SANDBOX_NANO_CPUS=1000000000
SANDBOX_PIDS_LIMIT=64
SANDBOX_TMPFS_MB=64
SANDBOX_TIMEOUT_MS=10000
SANDBOX_MAX_CODE_BYTES=65536
SANDBOX_MAX_STDIN_BYTES=65536
SANDBOX_MAX_OUTPUT_BYTES=65536
DOCKER_REQUEST_TIMEOUT_MS=30000
# Override only if Docker uses a different socket/pipe.
# Windows default: //./pipe/dockerDesktopLinuxEngine
# Linux/macOS default: /var/run/docker.sock
# DOCKER_SOCKET_PATH=/var/run/docker.sock
