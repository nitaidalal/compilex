FROM python:3.14-alpine

RUN addgroup -g 10001 -S sandbox \
    && adduser -u 10001 -S -D -H -G sandbox sandbox \
    && mkdir -p /workspace \
    && chown sandbox:sandbox /workspace

ENV HOME=/workspace PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /workspace
USER 10001:10001
CMD ["python", "--version"]
